//appTrayMenu 托盘菜单
import config;
import win.ui.menu;

namespace ui;

class appTrayMenu{
	ctor(winform){
		var popmenu = ..win.ui.popmenu(winform);//创建弹出菜单

		popmenu.add("设置",function(){ 
			..mainForm.show();
			..win.setForeground(..mainForm.hwnd);
		})
		
		popmenu.add();//分隔线 
		
		var id = popmenu.add('启用输入跟踪提示\tCtrl+单击托盘',function(id){
			..config.setting.imeBarDisabled = !..imeBar.paused; 
			..imeBar.imeWatch(!..config.setting.imeBarDisabled);
			..mainForm.chkImeBarDisabled.checked = !..config.setting.imeBarDisabled;
			..config.setting.save();
		});
		popmenu.check(id,!..imeBar.paused,0/*_MF_BYCOMMAND*/);
		 
		popmenu.add();//分隔线 
		
		// 内存优化菜单
		import app.memReduce;
		var memInfo = app.memReduce.getStatus();
		popmenu.add('内存清理 (' + memInfo.memoryLoad + '%)',function(id){
			var result = app.memReduce.doClean("normal");
			if(..mainForm.updateMemInfo) ..mainForm.updateMemInfo();
		});
		
		popmenu.add();//分隔线 
		
		// 置顶窗口菜单
		import app.topmost;
		var topmostCount = app.topmost.getTopmostCount();
		
		popmenu.add('置顶当前窗口',function(id){
			app.topmost.toggleForegroundTopmost();
		});
		
		if(topmostCount > 0){
			var topmostList = app.topmost.getTopmostList();
			var subMenu = ..win.ui.popmenu(winform);
			for(i, info in topmostList){
				var title = info.title;
				if(!#title) title = "窗口";
				subMenu.add(title, function(id){
					app.topmost.removeTopmost(info.hwnd);
				});
			}
			subMenu.add();
			subMenu.add('取消所有置顶', function(id){
				app.topmost.removeAllTopmost();
			});
			popmenu.add('置顶窗口(' + topmostCount + ')', subMenu);
		}
		
		popmenu.add();//分隔线 
		
		popmenu.add('退出程序',function(id){ 
			winform.close();
			..win.quitMessage();
		});	 
		
		return popmenu; 
	};
}

/**intellisense()
ui.appTrayMenu() = 托盘菜单\n!popmenu.
end intellisense**/
