//topmost 置顶窗口管理
import win;
import winex;
import config;
import app.topmostOverlay;
import mouse;

namespace app.topmost;

// GDI32 用于绘制高亮边框
::Gdi32 := ..raw.loadDll("Gdi32.dll");

// 置顶窗口表 { hwnd = {title=窗口标题, cls=窗口类名} }
// 注意：hwnd为指针类型，仅在当前会话有效，不跨重启持久化
var topmostWindows = {};

var DEBUG_SNAPSHOT_PATH = ..io.appData("/aardio/std/ImTip/topmost-debug.txt");

// 热键ID
var hotkeyId = null;

// 持续维护置顶状态的定时器
var maintainTimerId = null;

// 防抖：防止热键重复触发的时间间隔（毫秒）
var TOGGLE_DEBOUNCE_MS = 300;
var lastToggleTime = 0;

// 窗口选择模式状态
var selectMode = false;
var selectTipForm = null;
var mouseHook = null;
var highlightHwnd = null;
var highlightTimer = null;
var originalCursor = null;
var lastHighlightRect = null; // 上一次高亮区域，用于清除

normalizeDebugText = function(text){
	if(text === null) return "";
	text = tostring(text);
	text = ..string.replace(text, "[\r\n\t]+", " ");
	return text;
}

describeWindowForDebug = function(hwnd, targetHwnd){
	if(!hwnd || !..win.isWindow(hwnd)) return null;
	
	var ownerHwnd = ::User32.GetWindow(hwnd, 4/*_GW_OWNER*/);
	var rootOwner = ::User32.GetAncestor(hwnd, 3/*_GA_ROOTOWNER*/);
	var style = ::User32.GetWindowLong(hwnd, -16/*_GWL_STYLE*/);
	var exStyle = ::User32.GetWindowLong(hwnd, -20/*_GWL_EXSTYLE*/);
	var title = ..winex.getText(hwnd);
	if(!#title) title = ..win.getText(hwnd);
	
	return {
		hwnd = tostring(hwnd);
		title = normalizeDebugText(title);
		cls = normalizeDebugText(..win.getClass(hwnd));
		owner = ownerHwnd ? tostring(ownerHwnd) : "";
		rootOwner = rootOwner ? tostring(rootOwner) : "";
		style = ..string.format("0x%X", style);
		exStyle = ..string.format("0x%X", exStyle);
		visible = ..win.isVisible(hwnd) ? 1 : 0;
		related = isRelatedPopupWindow(hwnd, targetHwnd) ? 1 : 0;
	};
}

writeDebugSnapshot = function(targetHwnd, info, activeRelated){
	if(!targetHwnd || !info) return;
	
	info.debugCounter = (info.debugCounter || 0) + 1;
	if(info.debugCounter % 2) return;
	
	var lines = {};
	var foregroundHwnd = ..win.getForeground();
	var targetInfo = describeWindowForDebug(targetHwnd, targetHwnd);
	var foregroundInfo = describeWindowForDebug(foregroundHwnd, targetHwnd);
	
	..table.push(lines, "target=" + (targetInfo ? targetInfo.hwnd : ""));
	..table.push(lines, "targetTitle=" + normalizeDebugText(info.title));
	..table.push(lines, "targetClass=" + normalizeDebugText(info.cls));
	..table.push(lines, "foreground=" + (foregroundInfo ? foregroundInfo.hwnd : ""));
	..table.push(lines, "activeRelatedCount=" + tostring(#activeRelated));
	..table.push(lines, "");
	
	var appendWindow = function(prefix, item){
		if(!item) return;
		..table.push(lines, prefix + " hwnd=" + item.hwnd);
		..table.push(lines, prefix + " cls=" + item.cls);
		..table.push(lines, prefix + " title=" + item.title);
		..table.push(lines, prefix + " owner=" + item.owner);
		..table.push(lines, prefix + " rootOwner=" + item.rootOwner);
		..table.push(lines, prefix + " style=" + item.style + " exStyle=" + item.exStyle + " visible=" + tostring(item.visible) + " related=" + tostring(item.related));
		..table.push(lines, "");
	}
	appendWindow("target", targetInfo);
	appendWindow("foreground", foregroundInfo);
	
	var seen = {};
	if(targetInfo) seen[targetInfo.hwnd] = true;
	if(foregroundInfo) seen[foregroundInfo.hwnd] = true;
	
	var candidateCount = 0;
	var desktop = ::User32.GetDesktopWindow();
	var hwnd = ::User32.GetTopWindow(desktop);
	while(hwnd && candidateCount < 12){
		if(..win.isWindow(hwnd) && ..win.isVisible(hwnd)){
			var ownerHwnd = ::User32.GetWindow(hwnd, 4/*_GW_OWNER*/);
			var rootOwner = ::User32.GetAncestor(hwnd, 3/*_GA_ROOTOWNER*/);
			var style = ::User32.GetWindowLong(hwnd, -16/*_GWL_STYLE*/);
			if(hwnd != targetHwnd && (!seen[tostring(hwnd)]) && (
				ownerHwnd == targetHwnd
				|| rootOwner == targetHwnd
				|| (style & 0x80000000/*_WS_POPUP*/)
				|| ownerHwnd
			)){
				var item = describeWindowForDebug(hwnd, targetHwnd);
				appendWindow("candidate[" + tostring(candidateCount + 1) + "]", item);
				seen[tostring(hwnd)] = true;
				candidateCount++;
			}
		}
		hwnd = ::User32.GetWindow(hwnd, 2/*_GW_HWNDNEXT*/);
	}
	
	try{ ..string.save(DEBUG_SNAPSHOT_PATH, ..string.join(lines, "\r\n")); }
}

isRelatedPopupWindow = function(hwnd, targetHwnd){
	if(!hwnd || hwnd == targetHwnd) return false;
	if(!..win.isWindow(hwnd) || !..win.isVisible(hwnd)) return false;
	if(..mainForm && hwnd == ..mainForm.hwnd) return false;
	
	var style = ::User32.GetWindowLong(hwnd, -16/*_GWL_STYLE*/);
	if(style & 0x40000000/*_WS_CHILD*/) return false;
	
	var ownerHwnd = ::User32.GetWindow(hwnd, 4/*_GW_OWNER*/);
	if(ownerHwnd == targetHwnd) return true;
	if(ownerHwnd){
		var ownerRootOwner = ::User32.GetAncestor(ownerHwnd, 3/*_GA_ROOTOWNER*/);
		if(ownerRootOwner && ownerRootOwner == targetHwnd) return true;
	}
	
	if(!(style & 0x80000000/*_WS_POPUP*/)) return false;
	
	var rootOwner = ::User32.GetAncestor(hwnd, 3/*_GA_ROOTOWNER*/);
	return rootOwner && rootOwner == targetHwnd;
}

syncRelatedPopups = function(targetHwnd, info){
	if(!targetHwnd || !info) return;
	
	info._scanCounter = (info._scanCounter or 0) + 1;
	
	// 每3次扫描才完整遍历一次窗口树，减少CPU开销
	var fullScan = (info._scanCounter % 3) == 1;
	
	var activeRelated = {};
	var trackPopup = function(hwnd){
		if(!isRelatedPopupWindow(hwnd, targetHwnd)) return;
		applyTopmostState(hwnd, true);
		activeRelated[hwnd] = true;
	}
	
	trackPopup(..win.getForeground());
	
	if(fullScan){
		var desktop = ::User32.GetDesktopWindow();
		var hwnd = ::User32.GetTopWindow(desktop);
		while(hwnd){
			trackPopup(hwnd);
			hwnd = ::User32.GetWindow(hwnd, 2/*_GW_HWNDNEXT*/);
		}
	}
	
	info.related = info.related or {};
	for(hwnd in info.related){
		if(activeRelated[hwnd]) continue;
		if(topmostWindows[hwnd]) continue;
		if(hwnd && ..win.isWindow(hwnd)){
			applyTopmostState(hwnd, false);
		}
	}
	info.related = activeRelated;
	writeDebugSnapshot(targetHwnd, info, activeRelated);
}

clearRelatedTopmost = function(info){
	if(!info || !info.related) return;
	for(hwnd in info.related){
		if(topmostWindows[hwnd]) continue;
		if(hwnd && ..win.isWindow(hwnd)){
			applyTopmostState(hwnd, false);
		}
	}
	info.related = {};
}

applyTopmostState = function(hwnd, enabled){
	if(!hwnd || !..win.isWindow(hwnd)) return false;
	
	var insertAfter = enabled ? -1/*_HWND_TOPMOST*/ : -2/*_HWND_NOTOPMOST*/;
	var exStyle = ::User32.GetWindowLong(hwnd, -20/*_GWL_EXSTYLE*/);
	if(enabled){
		::User32.SetWindowLong(hwnd, -20/*_GWL_EXSTYLE*/, exStyle | 0x8/*_WS_EX_TOPMOST*/);
	}
	else {
		::User32.SetWindowLong(hwnd, -20/*_GWL_EXSTYLE*/, exStyle & ~0x8/*_WS_EX_TOPMOST*/);
	}
	
	::User32.SetWindowPos(hwnd, insertAfter, 0, 0, 0, 0,
		0x3/*_SWP_NOMOVE | _SWP_NOSIZE*/ | 0x10/*_SWP_NOACTIVATE*/ | 0x40/*_SWP_SHOWWINDOW*/);
	::User32.SetWindowPos(hwnd, insertAfter, 0, 0, 0, 0,
		0x3/*_SWP_NOMOVE | _SWP_NOSIZE*/ | 0x10/*_SWP_NOACTIVATE*/);
	return true;
}

ensureMaintainTimer = function(){
	if(maintainTimerId) return maintainTimerId;
	
	maintainTimerId = ..win.setInterval(function(){
		for(hwnd, info in topmostWindows){
			if(!hwnd || !info) continue;
			if(!..win.isWindow(hwnd)){
				clearRelatedTopmost(info);
				try{ ..app.topmostOverlay.removeOverlay(hwnd); }
				topmostWindows[hwnd] = null;
				continue;
			}
			
			var styleEx = ::User32.GetWindowLong(hwnd, -20/*_GWL_EXSTYLE*/);
			if(!(styleEx & 0x8/*_WS_EX_TOPMOST*/)){
				applyTopmostState(hwnd, true);
			}
			syncRelatedPopups(hwnd, info);
			
			if(!..app.topmostOverlay.hasOverlay(hwnd)){
				try{ ..app.topmostOverlay.createOverlay(hwnd); }
			}
		}
	}, 800);
	
	return maintainTimerId;
}

// 为置顶窗口设置 imeBar 固定定位（使用窗口位置而非鼠标位置）
setupImeBarFix = function(){
	if(!..imeBar) return;
	
	// 保存原有的 onImeForegroundWindow 回调
	var prevOnImeForegroundWindow = ..imeBar.onImeForegroundWindow;
	
	// 保存原有的 getCaretEx
	var prevGetCaretEx = ..imeBar.getCaretEx;
	
	..imeBar.onImeForegroundWindow = function(hwnd, cls){
		// 先调用原有回调
		if(prevOnImeForegroundWindow){
			var result = prevOnImeForegroundWindow(hwnd, cls);
			if(result === false) return false;
		}
		
		// 检查当前窗口是否是置顶窗口
		if(isTopmost(hwnd)){
			// 为置顶窗口设置自定义光标获取：使用窗口左上角位置
			..imeBar.getCaretEx = function(hwndForeground){
				if(!..win.isWindow(hwndForeground)) return null, null;
				var x,y = ..win.getPos(hwndForeground, true);
				if(!x && !y) return null, null;
				var caret = ::RECT(x, y, 0, 0);
				caret.hwnd = hwndForeground;
				return caret, hwndForeground;
			}
		}
		else {
			// 非置顶窗口恢复原有的 getCaretEx
			..imeBar.getCaretEx = prevGetCaretEx;
		}
	}
}

// 企业微信这类 Electron/Qt 应用常把焦点放在子窗口上，置顶时需要落到根窗口。
resolveTopLevelWindow = function(hwnd){
	if(!hwnd || !..win.isWindow(hwnd)) return null;
	
	var desktop = ::User32.GetDesktopWindow();
	var rootOwner = ::User32.GetAncestor(hwnd, 3/*_GA_ROOTOWNER*/);
	if(rootOwner && rootOwner != desktop && ..win.isWindow(rootOwner) && ..win.isVisible(rootOwner)){
		hwnd = rootOwner;
	}
	
	var ownerHwnd = ::User32.GetWindow(hwnd, 4/*_GW_OWNER*/);
	if(ownerHwnd && ownerHwnd != hwnd && ..win.isWindow(ownerHwnd) && ..win.isVisible(ownerHwnd)){
		hwnd = ownerHwnd;
	}
	
	return hwnd;
}

// 获取前台窗口信息
getForegroundInfo = function(){
	var hwnd = ..win.getForeground();
	if(!hwnd) return null;
	
	// 排除桌面窗口
	var desktop = ::User32.GetDesktopWindow();
	if(hwnd == desktop) return null;
	
	var shellWnd = ::User32.FindWindow("Progman",null);
	if(hwnd == shellWnd) return null;
	
	// 排除ImTip主窗口
	if(..mainForm && hwnd == ..mainForm.hwnd) return null;
	
	hwnd = resolveTopLevelWindow(hwnd);
	if(!hwnd) return null;
	if(..mainForm && hwnd == ..mainForm.hwnd) return null;
	
	// 获取窗口标题
	var title = ..winex.getText(hwnd);
	if(!#title) title = ..win.getText(hwnd);
	
	// 获取窗口类名
	var cls = ..win.getClass(hwnd);
	
	// 排除不可见窗口
	if(!..win.isVisible(hwnd)) return null;
	
	// 排除无标题且类名为按钮类的窗口
	if(!#title && ..string.find(cls,"Button")) return null;
	
	return { hwnd = hwnd; title = title; cls = cls };
}

// 置顶当前前台窗口（如果已置顶则取消）
toggleForegroundTopmost = function(){
	var now = ..time.tick();
	if(now - lastToggleTime < TOGGLE_DEBOUNCE_MS){
		return false;
	}
	lastToggleTime = now;
	
	var info = getForegroundInfo();
	if(!info) return false;
	
	var hwnd = info.hwnd;
	var title = info.title;
	var cls = info.cls;
	if(!#title) title = "窗口";
	
	// 如果已经置顶，则取消置顶
	if(topmostWindows[hwnd]){
		clearRelatedTopmost(topmostWindows[hwnd]);
		applyTopmostState(hwnd, false);
		topmostWindows[hwnd] = null;
		try{ ..app.topmostOverlay.removeOverlay(hwnd); }
		return true;
	}
	
	// 设置置顶 - 使用多种方法确保生效
	applyTopmostState(hwnd, true);
	
	topmostWindows[hwnd] = { title = info.title; cls = info.cls; related = {} };
	writeDebugSnapshot(hwnd, topmostWindows[hwnd], {});
	ensureMaintainTimer();
	try{ ..app.topmostOverlay.createOverlay(hwnd); }
	return true;
}

// 取消指定窗口的置顶
removeTopmost = function(hwnd){
	if(!hwnd) return false;
	
	if(topmostWindows[hwnd]){
		clearRelatedTopmost(topmostWindows[hwnd]);
		applyTopmostState(hwnd, false);
		
		topmostWindows[hwnd] = null;
		try{ ..app.topmostOverlay.removeOverlay(hwnd); }
		return true;
	}
	return false;
}

// 取消所有置顶窗口
removeAllTopmost = function(){
	var count = 0;
	for(hwnd, info in topmostWindows){
		if(hwnd && ..win.isWindow(hwnd)){
			clearRelatedTopmost(info);
			applyTopmostState(hwnd, false);
			try{ ..app.topmostOverlay.removeOverlay(hwnd); }
			count++;
		}
	}
	topmostWindows = {};
	try{ ..app.topmostOverlay.removeAllOverlays(); }
	return count;
}

getDebugSnapshotPath = function(){
	return DEBUG_SNAPSHOT_PATH;
}

// 获取置顶窗口数量
getTopmostCount = function(){
	cleanInvalidWindows();
	
	var count = 0;
	for(hwnd in topmostWindows){
		count++;
	}
	return count;
}

// 获取所有置顶窗口信息
getTopmostList = function(){
	cleanInvalidWindows();
	
	var list = {};
	for(hwnd, info in topmostWindows){
		..table.push(list, { hwnd = hwnd; title = info.title; cls = info.cls });
	}
	return list;
}

// 检查窗口是否已置顶
isTopmost = function(hwnd){
	if(!hwnd) return false;
	return !!topmostWindows[hwnd];
}

// 清理已不存在的窗口
cleanInvalidWindows = function(){
	for(hwnd in topmostWindows){
		if(!..win.isWindow(hwnd)){
			topmostWindows[hwnd] = null;
		}
	}
}

// 注册置顶热键
registerHotkey = function(winform){
	unregisterHotkey(winform);
	
	if(!..config.topmost.enabled) return false;
	
	var mod = ..config.topmost.hotkeyMod;
	var vk = ..config.topmost.hotkeyVk;
	
	if(!vk) return false;
	
	hotkeyId = winform.reghotkey(
		function(id,mod,vk){
			toggleForegroundTopmost();
		}, mod, vk
	);
	
	return !!hotkeyId;
}

// 注销置顶热键
unregisterHotkey = function(winform){
	if(hotkeyId && winform){
		winform.unreghotkey(hotkeyId);
		hotkeyId = null;
	}
}

// 热键值转可读字符串
hotkeyToString = function(mod, vk){
	if(!vk) return "";
	
	var parts = {};
	if(mod & 2/*_MOD_CONTROL*/) ..table.push(parts, "Ctrl");
	if(mod & 4/*_MOD_SHIFT*/) ..table.push(parts, "Shift");
	if(mod & 1/*_MOD_ALT*/) ..table.push(parts, "Alt");
	if(mod & 0x8/*_MOD_WIN*/) ..table.push(parts, "Win");
	
	// 功能键
	if(vk >= 0x70/*VK_F1*/ && vk <= 0x87/*VK_F24*/){
		..table.push(parts, "F" + (vk - 0x70 + 1));
	}
	// 字母键
	elseif(vk >= 0x41/*A*/ && vk <= 0x5A/*Z*/){
		..table.push(parts, ..string.pack(vk));
	}
	// 数字键
	elseif(vk >= 0x30/*0*/ && vk <= 0x39/*9*/){
		..table.push(parts, ..string.pack(vk));
	}
	
	return ..string.join(parts, "+");
}

// 显示选择模式提示气泡
showSelectTip = function(){
	if(selectTipForm){
		selectTipForm.close();
		selectTipForm = null;
	}
	
	var workLeft, workTop, workRight, workBottom = ..win.getWorkArea();
	var tipW = 220;
	var tipH = 36;
	var x = workLeft + ..math.round((workRight - workLeft - tipW) / 2);
	var y = workTop + ..math.round((workBottom - workTop - tipH) / 2);
	
	selectTipForm = ..win.form(
		text="窗口置顶";
		left=x; top=y; right=x+tipW; bottom=y+tipH;
		border="none";
		layered=true;
		toolwindow=true;
		topmost=true;
		transparent=0;
		bgcolor=0xE6434343;
	);
	selectTipForm.setPos(x, y);
	
	selectTipForm.add(
		tipText={cls="static"; text="\uF08D  选择要置顶的窗口..."; left=0; top=0; right=tipW; bottom=tipH; align="center"; valign="middle"; color=0xFFFFFFFF; font=LOGFONT(name='FontAwesome';h=-14)};
	);
	
	selectTipForm.show();
	..win.setForeground(selectTipForm.hwnd);
}

// 关闭选择模式提示气泡
closeSelectTip = function(){
	if(selectTipForm){
		selectTipForm.close();
		selectTipForm = null;
	}
}

// 获取鼠标下的窗口
getWindowUnderMouse = function(){
	var pt = ..POINT();
	::User32.GetCursorPos(pt);
	var hwnd = ::User32.WindowFromPoint(pt.x, pt.y);
	if(!hwnd) return null;
	
	// 向上查找顶层窗口
	var desktop = ::User32.GetDesktopWindow();
	while(hwnd && hwnd != desktop){
		var ownerHwnd = ::User32.GetWindow(hwnd, 4/*_GW_OWNER*/);
		var parentHwnd = ::User32.GetParent(hwnd);
		if(parentHwnd == desktop or ownerHwnd == null){
			break;
		}
		hwnd = ::User32.GetAncestor(hwnd, 3/*_GA_ROOTOWNER*/);
	}
	
	return hwnd;
}

// 绘制窗口高亮边框
drawHighlight = function(hwnd){
	if(!hwnd || !..win.isWindow(hwnd)) return;
	
	var rect = ..win.getRect(hwnd);
	if(!rect) return;
	
	// 窗口区域扩展2像素用于边框
	var left = rect.left - 2;
	var top = rect.top - 2;
	var right = rect.right + 2;
	var bottom = rect.bottom + 2;
	
	// 先清除上一次的高亮边框
	if(lastHighlightRect){
		clearHighlightRect(lastHighlightRect);
	}
	lastHighlightRect = {left=left; top=top; right=right; bottom=bottom};
	
	// 绘制新的高亮边框
	var screenHwnd = ::User32.GetDesktopWindow();
	var screenDc = ::User32.GetDCEx(screenHwnd, null, 0x1/*_DCX_CACHE*/ | 0x2/*_DCX_CLIPSIBLINGS*/ | 0x4/*_DCX_CLIPCHILDREN*/);
	if(!screenDc) return;
	
	var pen = ::Gdi32.CreatePen(0x1/*_PS_SOLID*/, 3, 0xFF33CC);
	var oldPen = ::Gdi32.SelectObject(screenDc, pen);
	var oldBrush = ::Gdi32.SelectObject(screenDc, ::Gdi32.GetStockObject(0/*_NULL_BRUSH*/));
	
	::Gdi32.Rectangle(screenDc, left, top, right, bottom);
	
	::Gdi32.SelectObject(screenDc, oldPen);
	::Gdi32.SelectObject(screenDc, oldBrush);
	::Gdi32.DeleteObject(pen);
	::User32.ReleaseDC(screenHwnd, screenDc);
}

// 清除高亮边框
clearHighlightRect = function(rect){
	if(!rect) return;
	
	var screenHwnd = ::User32.GetDesktopWindow();
	var screenDc = ::User32.GetDCEx(screenHwnd, null, 0x1/*_DCX_CACHE*/ | 0x2/*_DCX_CLIPSIBLINGS*/ | 0x4/*_DCX_CLIPCHILDREN*/);
	if(!screenDc) return;
	
	// 使用屏幕背景色清除边框
	var brush = ::Gdi32.CreateSolidBrush(0x0/*透明*/);
	var oldBrush = ::Gdi32.SelectObject(screenDc, brush);
	
	// 擦除整个区域
	::Gdi32.PatBlt(screenDc, rect.left - 3, rect.top - 3, rect.right - rect.left + 6, rect.bottom - rect.top + 6, 0x00420086/*_PATINVERT*/);
	
	::Gdi32.SelectObject(screenDc, oldBrush);
	::Gdi32.DeleteObject(brush);
	::User32.ReleaseDC(screenHwnd, screenDc);
}

// 清除高亮
clearHighlight = function(){
	if(lastHighlightRect){
		clearHighlightRect(lastHighlightRect);
		lastHighlightRect = null;
	}
	highlightHwnd = null;
}

// 开始窗口选择模式
startSelectMode = function(){
	if(selectMode) return;
	selectMode = true;
	
	// 保存原鼠标指针并设置为十字
	originalCursor = ::User32.LoadCursor(null, 0x7F02/*_IDC_CROSS*/);
	::User32.SetCursor(originalCursor);
	
	// 显示提示气泡
	showSelectTip();
	
	// 创建鼠标钩子监听鼠标移动和点击
	if(!mouseHook){
		mouseHook = ..mouse.global();
	}
	
	mouseHook.proc = function(msg, vk, x, y, flags, time, extra){
		if(!selectMode) return;
		
		if(msg == 0x200/*_WM_MOUSEMOVE*/){
			// 高亮鼠标下的窗口
			var hwnd = getWindowUnderMouse();
			if(hwnd && hwnd != highlightHwnd){
				highlightHwnd = hwnd;
			}
		}
		elseif(msg == 0x201/*_WM_LBUTTONDOWN*/){
			// 左键点击，选择窗口置顶
			var hwnd = getWindowUnderMouse();
			if(hwnd){
				// 排除桌面和ImTip
				var desktop = ::User32.GetDesktopWindow();
				if(hwnd != desktop && (!..mainForm or hwnd != ..mainForm.hwnd)){
					topmostSelectedWindow(hwnd);
				}
			}
			endSelectMode();
			return true;
		}
		elseif(msg == 0x204/*_WM_RBUTTONDOWN*/ or msg == 0x1B/*_WM_KEYDOWN*/ and vk == 0x1B/*_VK_ESCAPE*/){
			// 右键或ESC取消选择
			endSelectMode();
			return true;
		}
	}
	
	// 启动高亮绘制定时器
	if(highlightTimer){
		..win.clearInterval(highlightTimer);
	}
	highlightTimer = ..win.setInterval(function(){
		if(!selectMode) {
			..win.clearInterval(highlightTimer);
			highlightTimer = null;
			return;
		}
		// 重绘高亮
		if(highlightHwnd && ..win.isWindow(highlightHwnd)){
			drawHighlight(highlightHwnd);
		}
	}, 50);
}

// 结束窗口选择模式
endSelectMode = function(){
	if(!selectMode) return;
	selectMode = false;
	
	// 关闭提示气泡
	closeSelectTip();
	
	// 清除高亮
	if(lastHighlightRect){
		clearHighlightRect(lastHighlightRect);
		lastHighlightRect = null;
	}
	highlightHwnd = null;
	
	// 恢复原鼠标指针
	if(originalCursor){
		::User32.SetCursor(originalCursor);
	}
	
	// 关闭高亮定时器
	if(highlightTimer){
		..win.clearInterval(highlightTimer);
		highlightTimer = null;
	}
}

// 置顶选中的窗口
topmostSelectedWindow = function(hwnd){
	if(!hwnd) return;
	
	// 解析顶层窗口
	hwnd = resolveTopLevelWindow(hwnd);
	if(!hwnd) return;
	
	// 检查是否已置顶，如果已置顶则取消
	if(topmostWindows[hwnd]){
		clearRelatedTopmost(topmostWindows[hwnd]);
		applyTopmostState(hwnd, false);
		topmostWindows[hwnd] = null;
		try{ ..app.topmostOverlay.removeOverlay(hwnd); }
		return;
	}
	
	// 获取窗口信息
	var title = ..winex.getText(hwnd);
	if(!#title) title = ..win.getText(hwnd);
	var cls = ..win.getClass(hwnd);
	if(!#title) title = "窗口";
	
	// 设置置顶
	applyTopmostState(hwnd, true);
	
	topmostWindows[hwnd] = { title = title; cls = cls; related = {} };
	writeDebugSnapshot(hwnd, topmostWindows[hwnd], {});
	ensureMaintainTimer();
	try{ ..app.topmostOverlay.createOverlay(hwnd); }
}

// 切换前台窗口置顶（旧接口保留，内部改为选择模式）
toggleForegroundTopmost = function(){
	var now = ..time.tick();
	if(now - lastToggleTime < TOGGLE_DEBOUNCE_MS){
		return false;
	}
	lastToggleTime = now;
	
	// 进入窗口选择模式
	startSelectMode();
	return true;
}

/**intellisense(app.topmost)
getForegroundInfo() = 获取前台窗口信息\n返回 {hwnd,title,cls} 或 null
toggleForegroundTopmost() = 进入窗口选择模式\n点击窗口进行置顶/取消置顶\n返回是否成功
startSelectMode() = 开始窗口选择模式
endSelectMode() = 结束窗口选择模式
removeTopmost(hwnd) = 取消指定窗口的置顶\n返回是否成功
removeAllTopmost() = 取消所有置顶窗口\n返回取消的窗口数量
getTopmostCount() = 获取置顶窗口数量
getTopmostList() = 获取所有置顶窗口信息列表
isTopmost(hwnd) = 检查窗口是否已置顶
cleanInvalidWindows() = 清理已不存在的窗口
getDebugSnapshotPath() = 返回置顶窗口诊断快照文件路径
registerHotkey(winform) = 注册置顶热键\n返回是否成功
unregisterHotkey(winform) = 注销置顶热键
hotkeyToString(mod,vk) = 热键值转可读字符串
setupImeBarFix() = 为置顶窗口设置 imeBar 固定定位\n使提示栏固定在置顶窗口位置而非跟随鼠标
end intellisense**/
