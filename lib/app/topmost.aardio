//topmost 置顶窗口管理
import win;
import winex;
import config;
import app.topmostOverlay;

namespace app.topmost;

// 置顶窗口表 { hwnd = {title=窗口标题, cls=窗口类名} }
// 注意：hwnd为指针类型，仅在当前会话有效，不跨重启持久化
var topmostWindows = {};

// 热键ID
var hotkeyId = null;

// 持续维护置顶状态的定时器
var maintainTimerId = null;

isRelatedPopupWindow = function(hwnd, targetHwnd){
	if(!hwnd || hwnd == targetHwnd) return false;
	if(!..win.isWindow(hwnd) || !..win.isVisible(hwnd)) return false;
	if(..mainForm && hwnd == ..mainForm.hwnd) return false;
	
	var ownerHwnd = ::User32.GetWindow(hwnd, 4/*_GW_OWNER*/);
	if(ownerHwnd == targetHwnd) return true;
	
	var rootOwner = ::User32.GetAncestor(hwnd, 3/*_GA_ROOTOWNER*/);
	return rootOwner && rootOwner == targetHwnd;
}

syncRelatedPopups = function(targetHwnd, info){
	if(!targetHwnd || !info) return;
	
	var activeRelated = {};
	var trackPopup = function(hwnd){
		if(!isRelatedPopupWindow(hwnd, targetHwnd)) return;
		applyTopmostState(hwnd, true);
		activeRelated[hwnd] = true;
	}
	
	trackPopup(..win.getForeground());
	
	var desktop = ::User32.GetDesktopWindow();
	var hwnd = ::User32.GetTopWindow(desktop);
	while(hwnd){
		trackPopup(hwnd);
		hwnd = ::User32.GetWindow(hwnd, 2/*_GW_HWNDNEXT*/);
	}
	
	info.related = info.related || {};
	for(hwnd in info.related){
		if(activeRelated[hwnd]) continue;
		if(topmostWindows[hwnd]) continue;
		if(hwnd && ..win.isWindow(hwnd)){
			applyTopmostState(hwnd, false);
		}
	}
	info.related = activeRelated;
}

clearRelatedTopmost = function(info){
	if(!info || !info.related) return;
	for(hwnd in info.related){
		if(topmostWindows[hwnd]) continue;
		if(hwnd && ..win.isWindow(hwnd)){
			applyTopmostState(hwnd, false);
		}
	}
	info.related = {};
}

applyTopmostState = function(hwnd, enabled){
	if(!hwnd || !..win.isWindow(hwnd)) return false;
	
	var insertAfter = enabled ? -1/*_HWND_TOPMOST*/ : -2/*_HWND_NOTOPMOST*/;
	var exStyle = ::User32.GetWindowLong(hwnd, -20/*_GWL_EXSTYLE*/);
	if(enabled){
		::User32.SetWindowLong(hwnd, -20/*_GWL_EXSTYLE*/, exStyle | 0x8/*_WS_EX_TOPMOST*/);
	}
	else {
		::User32.SetWindowLong(hwnd, -20/*_GWL_EXSTYLE*/, exStyle & ~0x8/*_WS_EX_TOPMOST*/);
	}
	
	::User32.SetWindowPos(hwnd, insertAfter, 0, 0, 0, 0,
		0x3/*_SWP_NOMOVE | _SWP_NOSIZE*/ | 0x10/*_SWP_NOACTIVATE*/ | 0x40/*_SWP_SHOWWINDOW*/);
	::User32.SetWindowPos(hwnd, insertAfter, 0, 0, 0, 0,
		0x3/*_SWP_NOMOVE | _SWP_NOSIZE*/ | 0x10/*_SWP_NOACTIVATE*/);
	return true;
}

ensureMaintainTimer = function(){
	if(maintainTimerId) return maintainTimerId;
	
	maintainTimerId = ..win.setInterval(function(){
		for(hwnd, info in topmostWindows){
			if(!hwnd || !info) continue;
			if(!..win.isWindow(hwnd)){
				clearRelatedTopmost(info);
				topmostWindows[hwnd] = null;
				continue;
			}
			
			var styleEx = ::User32.GetWindowLong(hwnd, -20/*_GWL_EXSTYLE*/);
			if(!(styleEx & 0x8/*_WS_EX_TOPMOST*/)){
				applyTopmostState(hwnd, true);
			}
			syncRelatedPopups(hwnd, info);
			
			if(!..app.topmostOverlay.hasOverlay(hwnd)){
				try{ ..app.topmostOverlay.createOverlay(hwnd); }
			}
		}
	}, 800);
	
	return maintainTimerId;
}

// 为置顶窗口设置 imeBar 固定定位（使用窗口位置而非鼠标位置）
setupImeBarFix = function(){
	if(!..imeBar) return;
	
	// 保存原有的 onImeForegroundWindow 回调
	var prevOnImeForegroundWindow = ..imeBar.onImeForegroundWindow;
	
	// 保存原有的 getCaretEx
	var prevGetCaretEx = ..imeBar.getCaretEx;
	
	..imeBar.onImeForegroundWindow = function(hwnd, cls){
		// 先调用原有回调
		if(prevOnImeForegroundWindow){
			var result = prevOnImeForegroundWindow(hwnd, cls);
			if(result === false) return false;
		}
		
		// 检查当前窗口是否是置顶窗口
		if(isTopmost(hwnd)){
			// 为置顶窗口设置自定义光标获取：使用窗口左上角位置
			..imeBar.getCaretEx = function(hwndForeground){
				if(!..win.isWindow(hwndForeground)) return null, null;
				var x,y = ..win.getPos(hwndForeground, true);
				if(!x && !y) return null, null;
				var caret = ::RECT(x, y, 0, 0);
				caret.hwnd = hwndForeground;
				return caret, hwndForeground;
			}
		}
		else {
			// 非置顶窗口恢复原有的 getCaretEx
			..imeBar.getCaretEx = prevGetCaretEx;
		}
	}
}

// 企业微信这类 Electron/Qt 应用常把焦点放在子窗口上，置顶时需要落到根窗口。
resolveTopLevelWindow = function(hwnd){
	if(!hwnd || !..win.isWindow(hwnd)) return null;
	
	var desktop = ::User32.GetDesktopWindow();
	var rootOwner = ::User32.GetAncestor(hwnd, 3/*_GA_ROOTOWNER*/);
	if(rootOwner && rootOwner != desktop && ..win.isWindow(rootOwner) && ..win.isVisible(rootOwner)){
		hwnd = rootOwner;
	}
	
	var ownerHwnd = ::User32.GetWindow(hwnd, 4/*_GW_OWNER*/);
	if(ownerHwnd && ownerHwnd != hwnd && ..win.isWindow(ownerHwnd) && ..win.isVisible(ownerHwnd)){
		hwnd = ownerHwnd;
	}
	
	return hwnd;
}

// 获取前台窗口信息
getForegroundInfo = function(){
	var hwnd = ..win.getForeground();
	if(!hwnd) return null;
	
	// 排除桌面窗口
	var desktop = ::User32.GetDesktopWindow();
	if(hwnd == desktop) return null;
	
	var shellWnd = ::User32.FindWindow("Progman",null);
	if(hwnd == shellWnd) return null;
	
	// 排除ImTip主窗口
	if(..mainForm && hwnd == ..mainForm.hwnd) return null;
	
	hwnd = resolveTopLevelWindow(hwnd);
	if(!hwnd) return null;
	if(..mainForm && hwnd == ..mainForm.hwnd) return null;
	
	// 获取窗口标题
	var title = ..winex.getText(hwnd);
	if(!#title) title = ..win.getText(hwnd);
	
	// 获取窗口类名
	var cls = ..win.getClass(hwnd);
	
	// 排除不可见窗口
	if(!..win.isVisible(hwnd)) return null;
	
	// 排除无标题且类名为按钮类的窗口
	if(!#title && ..string.find(cls,"Button")) return null;
	
	return { hwnd = hwnd; title = title; cls = cls };
}

// 置顶当前前台窗口（如果已置顶则取消）
toggleForegroundTopmost = function(){
	var info = getForegroundInfo();
	if(!info) return false;
	
	var hwnd = info.hwnd;
	var title = info.title;
	var cls = info.cls;
	if(!#title) title = "窗口";
	
	// 如果已经置顶，则取消置顶
	if(topmostWindows[hwnd]){
		clearRelatedTopmost(topmostWindows[hwnd]);
		applyTopmostState(hwnd, false);
		topmostWindows[hwnd] = null;
		try{ ..app.topmostOverlay.removeOverlay(hwnd); }
		return true;
	}
	
	// 设置置顶 - 使用多种方法确保生效
	applyTopmostState(hwnd, true);
	
	topmostWindows[hwnd] = { title = info.title; cls = info.cls; related = {} };
	ensureMaintainTimer();
	try{ ..app.topmostOverlay.createOverlay(hwnd); }
	return true;
}

// 取消指定窗口的置顶
removeTopmost = function(hwnd){
	if(!hwnd) return false;
	
	if(topmostWindows[hwnd]){
		clearRelatedTopmost(topmostWindows[hwnd]);
		applyTopmostState(hwnd, false);
		
		topmostWindows[hwnd] = null;
		try{ ..app.topmostOverlay.removeOverlay(hwnd); }
		return true;
	}
	return false;
}

// 取消所有置顶窗口
removeAllTopmost = function(){
	var count = 0;
	for(hwnd, info in topmostWindows){
		if(hwnd && ..win.isWindow(hwnd)){
			clearRelatedTopmost(info);
			applyTopmostState(hwnd, false);
			try{ ..app.topmostOverlay.removeOverlay(hwnd); }
			count++;
		}
	}
	topmostWindows = {};
	return count;
}

// 获取置顶窗口数量
getTopmostCount = function(){
	cleanInvalidWindows();
	
	var count = 0;
	for(hwnd in topmostWindows){
		count++;
	}
	return count;
}

// 获取所有置顶窗口信息
getTopmostList = function(){
	cleanInvalidWindows();
	
	var list = {};
	for(hwnd, info in topmostWindows){
		..table.push(list, { hwnd = hwnd; title = info.title; cls = info.cls });
	}
	return list;
}

// 检查窗口是否已置顶
isTopmost = function(hwnd){
	if(!hwnd) return false;
	return !!topmostWindows[hwnd];
}

// 清理已不存在的窗口
cleanInvalidWindows = function(){
	for(hwnd in topmostWindows){
		if(!..win.isWindow(hwnd)){
			topmostWindows[hwnd] = null;
		}
	}
}

// 注册置顶热键
registerHotkey = function(winform){
	unregisterHotkey(winform);
	
	if(!..config.topmost.enabled) return false;
	
	var mod = ..config.topmost.hotkeyMod;
	var vk = ..config.topmost.hotkeyVk;
	
	if(!vk) return false;
	
	hotkeyId = winform.reghotkey(
		function(id,mod,vk){
			toggleForegroundTopmost();
		}, mod, vk
	);
	
	return !!hotkeyId;
}

// 注销置顶热键
unregisterHotkey = function(winform){
	if(hotkeyId && winform){
		winform.unreghotkey(hotkeyId);
		hotkeyId = null;
	}
}

// 热键值转可读字符串
hotkeyToString = function(mod, vk){
	if(!vk) return "";
	
	var parts = {};
	if(mod & 2/*_MOD_CONTROL*/) ..table.push(parts, "Ctrl");
	if(mod & 4/*_MOD_SHIFT*/) ..table.push(parts, "Shift");
	if(mod & 1/*_MOD_ALT*/) ..table.push(parts, "Alt");
	if(mod & 0x8/*_MOD_WIN*/) ..table.push(parts, "Win");
	
	// 功能键
	if(vk >= 0x70/*VK_F1*/ && vk <= 0x87/*VK_F24*/){
		..table.push(parts, "F" + (vk - 0x70 + 1));
	}
	// 字母键
	elseif(vk >= 0x41/*A*/ && vk <= 0x5A/*Z*/){
		..table.push(parts, ..string.pack(vk));
	}
	// 数字键
	elseif(vk >= 0x30/*0*/ && vk <= 0x39/*9*/){
		..table.push(parts, ..string.pack(vk));
	}
	
	return ..string.join(parts, "+");
}

/**intellisense(app.topmost)
getForegroundInfo() = 获取前台窗口信息\n返回 {hwnd,title,cls} 或 null
toggleForegroundTopmost() = 切换当前前台窗口的置顶状态\n已置顶则取消，未置顶则置顶\n返回是否成功
removeTopmost(hwnd) = 取消指定窗口的置顶\n返回是否成功
removeAllTopmost() = 取消所有置顶窗口\n返回取消的窗口数量
getTopmostCount() = 获取置顶窗口数量
getTopmostList() = 获取所有置顶窗口信息列表
isTopmost(hwnd) = 检查窗口是否已置顶
cleanInvalidWindows() = 清理已不存在的窗口
registerHotkey(winform) = 注册置顶热键\n返回是否成功
unregisterHotkey(winform) = 注销置顶热键
hotkeyToString(mod,vk) = 热键值转可读字符串
setupImeBarFix() = 为置顶窗口设置 imeBar 固定定位\n使提示栏固定在置顶窗口位置而非跟随鼠标
end intellisense**/
