//imgPreview 空格键预览图片
import win;
import winex;
import win.ui;
import com;
import key.hook;
import gdip.bitmap;
import config;

namespace app.imgPreview;

// 预览窗口
var previewForm = null;

// 资源管理器预览窗格状态
var shellPreviewHwnd = null;
var shellPreviewActive = false;

// 键盘钩子
var kbHook = null;

// 支持的图片扩展名
var imageExts = {
	[".jpg"]=1; [".jpeg"]=1; [".png"]=1; [".gif"]=1;
	[".bmp"]=1; [".tif"]=1; [".tiff"]=1; [".webp"]=1;
	[".ico"]=1; [".svg"]=1; [".heic"]=1; [".heif"]=1;
};

// 支持的视频扩展名
var videoExts = {
	[".mp4"]=1; [".m4v"]=1; [".mov"]=1; [".avi"]=1;
	[".mkv"]=1; [".wmv"]=1; [".flv"]=1; [".webm"]=1;
	[".mpeg"]=1; [".mpg"]=1; [".ts"]=1; [".m2ts"]=1;
};

// 支持的文档扩展名
var documentExts = {
	[".pdf"]=1;
};

// 获取文件预览类型
getPreviewType = function(path){
	if(!#path) return null;
	var ext = ..string.lower(..io.split(path).ext);
	if(imageExts[ext]) return "image";
	if(videoExts[ext]) return "video";
	if(documentExts[ext]) return "document";
	return null;
}

// 判断文件是否为图片
isImageFile = function(path){
	return getPreviewType(path) == "image";
}

// 获取资源管理器中选中的文件路径
getSelectedFiles = function(){
	var files = {};
	
	// 获取当前前台窗口
	var hwnd = ..win.getForeground();
	if(!hwnd) return files;
	
	var cls = ..win.getClass(hwnd);
	
	// Explorer 主窗口或目录窗口
	if(cls != "ExploreWClass" && cls != "CabinetWClass") return files;
	
	// 通过 Shell COM 接口获取选中文件
	try{
		var shell = ..com.CreateObject("Shell.Application");
		if(!shell) return files;
		
		// 遍历所有窗口查找匹配的 Explorer
		var windows = shell.Windows();
		for(i=0; windows.Count-1){
			var w = windows.Item(i);
			if(!w) continue;
			
			var wHwnd = 0;
			try{ wHwnd = w.HWND; } catch(e){ wHwnd = 0; }
			
			if(wHwnd != hwnd) continue;
			
			// 获取选中项
			var selItems = w.Document.SelectedItems();
			for(j=0; selItems.Count-1){
				var item = selItems.Item(j);
				if(!item) continue;
				var path = item.Path;
				if(#path && ..io.exist(path)){
					..table.push(files, path);
				}
			}
			break;
		}
	}
	catch(e){
		// COM 接口失败
	}
	
	return files;
}

// 获取选中文件中的第一个图片
getSelectedPreviewFile = function(){
	var files = getSelectedFiles();
	for(i=1; #files){
		var previewType = getPreviewType(files[i]);
		if(previewType){
			return {
				path = files[i];
				type = previewType;
				ownerHwnd = ..win.getForeground();
			}
		}
	}
	return null;
}

// 模拟 Alt+P 切换资源管理器预览窗格
toggleExplorerPreviewPane = function(hwnd){
	if(!hwnd) return false;
	..win.setForeground(hwnd);
	::User32.keybd_event(0x12/*_VK_MENU*/,0,0,0);
	::User32.keybd_event(0x50/*_VK_P*/,0,0,0);
	::User32.keybd_event(0x50/*_VK_P*/,0,2/*_KEYEVENTF_KEYUP*/,0);
	::User32.keybd_event(0x12/*_VK_MENU*/,0,2/*_KEYEVENTF_KEYUP*/,0);
	return true;
}

// 显示资源管理器预览窗格
showShellPreview = function(hwnd){
	if(!hwnd) return false;
	if(shellPreviewActive && shellPreviewHwnd == hwnd) return true;
	if(shellPreviewActive) closePreview();
	if(!toggleExplorerPreviewPane(hwnd)) return false;
	shellPreviewHwnd = hwnd;
	shellPreviewActive = true;
	return true;
}

// 关闭预览窗口
closePreview = function(){
	if(previewForm){
		previewForm.close();
		previewForm = null;
	}
	if(shellPreviewActive && shellPreviewHwnd){
		toggleExplorerPreviewPane(shellPreviewHwnd);
	}
	shellPreviewHwnd = null;
	shellPreviewActive = false;
}

// 显示图片预览
showPreview = function(imagePath){
	if(!imagePath || !#imagePath) return false;
	if(!..io.exist(imagePath)) return false;
	
	// 如果已有预览窗口，先关闭
	if(previewForm){
		previewForm.close();
		previewForm = null;
	}
	
	// 加载图片获取尺寸
	var bmp = ..gdip.bitmap(imagePath);
	if(!bmp) return false;
	closePreview();
	
	var imgW, imgH = bmp.width, bmp.height;
	bmp = null;
	
	if(!imgW || !imgH) return false;
	
	// 获取屏幕工作区大小
	var workLeft, workTop, workRight, workBottom = ..win.getWorkArea();
	var screenW = workRight - workLeft;
	var screenH = workBottom - workTop;
	if(screenW <= 0 || screenH <= 0){
		screenW = ::User32.GetSystemMetrics(0/*_SM_CXSCREEN*/);
		screenH = ::User32.GetSystemMetrics(1/*_SM_CYSCREEN*/);
		workLeft = 0;
		workTop = 0;
	}
	
	// 计算预览窗口大小（图片按比例缩放，最大占屏幕 80%）
	var maxW = screenW * 0.8;
	var maxH = screenH * 0.8;
	var scale = 1;
	if(imgW > maxW || imgH > maxH){
		var scaleX = maxW / imgW;
		var scaleY = maxH / imgH;
		scale = ..math.min(scaleX, scaleY);
	}
	
	var winW = ..math.round(imgW * scale);
	var winH = ..math.round(imgH * scale);
	
	// 窗口居中
	var x = workLeft + ..math.round((screenW - winW) / 2);
	var y = workTop + ..math.round((screenH - winH) / 2);
	
	// 创建预览窗口
	previewForm = ..win.form(
		text="图片预览 - " + ..io.split(imagePath).name;
		left=x; top=y; right=x+winW; bottom=y+winH;
		border="none";
		max=false; min=false;
		bgcolor=0x000000;
	);
	
	previewForm.add(
		imgView={cls="plus"; left=0; top=0; right=winW; bottom=winH; dl=1; dt=1; dr=1; db=1; z=1};
	);
	
	// 设置图片背景
	previewForm.imgView.background = imagePath;
	
	// 点击关闭预览
	previewForm.imgView.onMouseDown = function(wParam,lParam){
		closePreview();
	}
	
	// 按空格或ESC关闭预览
	previewForm.onKeyDown = function(vk,flags){
		if(vk == 0x20/*_VK_SPACE*/ || vk == 0x1B/*_VK_ESCAPE*/){
			closePreview();
		}
	}
	
	// 鼠标滚轮关闭预览
	previewForm.onMouseWheel = function(wParam,lParam){
		closePreview();
	}
	
	// 显示窗口
	previewForm.show();
	..win.setForeground(previewForm.hwnd);
	
	return true;
}

// 异步执行预览逻辑（从钩子回调中调用，避免阻塞）
var doPreviewAsync = function(previewTarget){
	if(!previewTarget || !previewTarget.type || !previewTarget.path) return;

	try{
		if(previewTarget.type == "image"){
			showPreview(previewTarget.path);
		}
		else {
			showShellPreview(previewTarget.ownerHwnd);
		}
	}
	catch(e){
		return;
	}
}

// 安装键盘钩子
installHook = function(){
	uninstallHook();
	
	if(!..config.imgPreview.enabled) return false;
	
	kbHook = ..key.hook();
	
	// 检查钩子是否安装成功
	if(!kbHook || !kbHook.hhk){
		kbHook = null;
		return false;
	}
	
	kbHook.proc = function(msg,vkCode,scanCode,injected,flags,timeStamp,extraInfo){
		// 忽略模拟按键
		if(injected) return;

		if(msg == 0x100/*_WM_KEYDOWN*/ && vkCode == 0x1B/*_VK_ESCAPE*/){
			if(previewForm || shellPreviewActive){
				closePreview();
				return true;
			}
			return;
		}
		
		// 仅处理按键按下消息
		if(msg != 0x100/*_WM_KEYDOWN*/ && msg != 0x104/*_WM_SYSKEYDOWN*/) return;
		
		// 仅处理空格键
		if(vkCode != 0x20/*_VK_SPACE*/) return;
		
		// 如果已有预览窗口或预览窗格，关闭它并拦截空格
		if(previewForm || shellPreviewActive){
			closePreview();
			return true;
		}

		var previewTarget = null;
		try{
			previewTarget = getSelectedPreviewFile();
		}
		catch(e){
			return;
		}
		if(!previewTarget) return;

		// 异步执行预览逻辑，避免在钩子里直接创建窗口
		..mainForm.setTimeout(function(){
			doPreviewAsync(previewTarget);
		}, 10);
		
		// 拦截空格键
		return true;
	}
	
	return true;
}

// 卸载键盘钩子
uninstallHook = function(){
	if(kbHook){
		kbHook.close();
		kbHook = null;
	}
}

/**intellisense(app.imgPreview)
isImageFile(path) = 判断文件是否为图片\n返回 true 或 false
getSelectedFiles() = 获取资源管理器中选中的文件路径列表\n返回字符串数组
getSelectedPreviewFile() = 获取选中文件中的第一个可预览文件\n返回包含路径和类型的对象或 null
showPreview(imagePath) = 显示图片预览窗口\n返回是否成功
closePreview() = 关闭预览窗口
installHook() = 安装键盘钩子监听空格键\n返回是否成功
uninstallHook() = 卸载键盘钩子
end intellisense**/
