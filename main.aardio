	..imeBar.imeWatch(!..config.setting.imeBarDisabled);
	..config.setting.save();
}

// 内存优化功能
import app.memReduce;

// 更新内存显示
updateMemInfo = function(){
	var info = app.memReduce.getStatus();
	mainForm.lblMemInfo.text = string.format("内存: %d%% (%s / %s)", 
		info.memoryLoad, 
		app.memReduce.formatSize(info.usedPhys),
		info.totalPhysFormatted);
	
	// 更新进度条
	mainForm.progressMem.setPos(info.memoryLoad);
	
	// 更新托盘图标提示
	mainForm.tray.tip = string.format("ImTip - 内存: %d%%", info.memoryLoad);
	
	// 更新托盘图标显示内存数字
	app.trayIcon.updateTrayIcon(mainForm.tray, info.memoryLoad);
}

// 初始显示
updateMemInfo();

// 定时更新内存信息
mainForm.setInterval(updateMemInfo, 2000);

// 内存清理按钮
mainForm.btnMemReduce.skin({
    color =={default= style.button.color};
    background = {
        default = 0xFF2196F3;
        hover = 0xFF1976D2;
        active = 0xFF0D47A1;
        disabled = 0xFFCCCCCC;
    };
});

mainForm.btnMemReduce.oncommand = function(id,event){
	// 根据配置选择清理模式
	var mode = config.memReduce.cleanMode;
	
	// 执行内存清理
	var result = app.memReduce.doClean(mode);
	
	// 更新显示
	updateMemInfo();
	
	// 显示结果
	if(result.freed > 0){
		mainForm.msgbox("内存清理完成\n释放: " + result.freedFormatted, "ImTip");
	}
	else {
		mainForm.msgbox("内存清理完成", "ImTip");
	}
}

// 自动清理配置
mainForm.chkAutoClean.checked = config.memReduce.enabled;
mainForm.chkAutoClean.oncommand = function(id,event){
	config.memReduce.enabled = owner.checked;
	config.memReduce.save();
}

// 清理模式选择
mainForm.cboCleanMode.oncommand = function(id,event){
	var selIndex = owner.selIndex;
	config.memReduce.cleanMode = selIndex == 1 ? "deep" : "normal";
	config.memReduce.save();
}

// 定时自动清理
autoCleanTimer = function(){
	if(!config.memReduce.enabled) return;
	
	var info = app.memReduce.getStatus();
	
	// 当内存使用超过阈值时自动清理
	if(info.memoryLoad >= config.memReduce.threshold){
		var mode = config.memReduce.cleanMode;
		app.memReduce.doClean(mode);
		updateMemInfo();
	}
}

// 启动定时自动清理（每分钟检查一次）
mainForm.setInterval(autoCleanTimer, 60000);

// 开机启动
mainForm.chkSysRun.checked = config.setting.sysRun;
mainForm.chkSysRun.oncommand = function(id,event){
	if(_STUDIO_INVOKED){
		error("此功能发布后可用。")
	}
	
	import sys.run;
	import process.admin;
	
	if( process.admin.isRunAs() &&  ! _WINXP ){
		import sys.runAsTask;
		
		sys.run("ImTip").delete();
		
		if(owner.checked){
			sys.runAsTask("ImTip","桌面助手").register("/sys");
			config.setting.sysRunAs = true;
		}
		else {
			sys.runAsTask("ImTip","桌面助手").delete();
			config.setting.sysRunAs = null;
		} 	
		
		mainForm.chkSysRun.text = "允许开机以管理权限启动"
	}
	else{
		if( config.setting.sysRunAs ){
			mainForm.msgboxErr('之前创建的开机启动项拥有管理权限，\n以相同的管理权限启动 ImTip 才能移除。')
			owner.checked = true;
			return ; 
		}
		
		if(owner.checked){
			sys.run("ImTip").register("/sys");
		}
		else {
			sys.run("ImTip").delete()
		} 
		
		mainForm.chkSysRun.text = "允许开机以普通权限启动（当前进程无管理权限）"
	}
	
	config.setting.sysRun = owner.checked;
	config.setting.save();
}

// 置顶窗口快捷键设置
mainForm.chkTopmost.checked = !!config.topmost.enabled;
mainForm.hotkeyTopmost.disabled = !config.topmost.enabled;

if(config.topmost.hotkeyMod && config.topmost.hotkeyVk){
	mainForm.hotkeyTopmost.sethotkey(config.topmost.hotkeyMod, config.topmost.hotkeyVk);
}
else {
	// 默认 Ctrl+Alt+T
	mainForm.hotkeyTopmost.sethotkey(2/*_MOD_CONTROL*/ | 1/*_MOD_ALT*/, 0x54/*_VK_T*/);
}

mainForm.chkTopmost.oncommand = function(id,event){
	if(owner.checked){
		var mod, vk = mainForm.hotkeyTopmost.gethotkey();
		if(!vk){
			// 默认 Ctrl+Alt+T
			mainForm.hotkeyTopmost.sethotkey(2/*_MOD_CONTROL*/ | 1/*_MOD_ALT*/, 0x54/*_VK_T*/);
			mod = 2/*_MOD_CONTROL*/ | 1/*_MOD_ALT*/;
			vk = 0x54/*_VK_T*/;
		}
		config.topmost.enabled = true;
		config.topmost.hotkeyMod = mod;
		config.topmost.hotkeyVk = vk;
		config.topmost.save();
		
		import app.topmost;
		app.topmost.registerHotkey(mainForm);
		mainForm.hotkeyTopmost.disabled = false;
	}
	else {
		import app.topmost;
		app.topmost.unregisterHotkey(mainForm);
		
		config.topmost.enabled = false;
		config.topmost.save();
		mainForm.hotkeyTopmost.disabled = true;
	}
}

mainForm.hotkeyTopmost.oncommand = function(id,event){
	if(!mainForm.chkTopmost.checked) return;
	
	var mod, vk = mainForm.hotkeyTopmost.gethotkey();
	if(!vk) return;
	
	import app.topmost;
	app.topmost.unregisterHotkey(mainForm);
	
	config.topmost.hotkeyMod = mod;
	config.topmost.hotkeyVk = vk;
	config.topmost.save();
	
	app.topmost.registerHotkey(mainForm);
}

 
if(..config.setting.imeBarDisabled){
	imeBar.imeWatch(false);  
}
else {
	mainForm.chkImeBarDisabled.checked = true; 
}

