mainForm.btnImTip.oncommand = function(id,event){
	if(!..mainSettingForm) ..mainSettingForm = ..mainForm.loadForm("\dlg\frmSetting.aardio"); 
	..mainSettingForm.show();  
	mainForm.show(false);
}

// 输入法提示启用/禁用
mainForm.chkImeBarDisabled.oncommand = function( id,event ){
	..config.setting.imeBarDisabled =  !mainForm.chkImeBarDisabled.checked; 
	..imeBar.imeWatch(!..config.setting.imeBarDisabled);
	..config.setting.save();
}

// 开机启动
mainForm.chkSysRun.checked = config.setting.sysRun;
mainForm.chkSysRun.oncommand = function(id,event){
	if(_STUDIO_INVOKED){
		error("此功能发布后可用。")
	}
	
	import sys.run;
	import process.admin;
	
	if( process.admin.isRunAs() &&  ! _WINXP ){
		import sys.runAsTask;
		
		sys.run("ImTip").delete();
		
		if(owner.checked){
			sys.runAsTask("ImTip","桌面助手").register("/sys");
			config.setting.sysRunAs = true;
		}
		else {
			sys.runAsTask("ImTip","桌面助手").delete();
			config.setting.sysRunAs = null;
		} 	
		
		mainForm.chkSysRun.text = "允许开机以管理权限启动"
	}
	else{
		if( config.setting.sysRunAs ){
			mainForm.msgboxErr('之前创建的开机启动项拥有管理权限，\n以相同的管理权限启动 ImTip 才能移除。')
			owner.checked = true;
			return ; 
		}
		
		if(owner.checked){
			sys.run("ImTip").register("/sys");
		}
		else {
			sys.run("ImTip").delete()
		} 
		
		mainForm.chkSysRun.text = "允许开机以普通权限启动（当前进程无管理权限）"
	}
	
	config.setting.sysRun = owner.checked;
	config.setting.save();
}

// 置顶窗口快捷键设置
mainForm.chkTopmost.checked = !!config.topmost.enabled;
mainForm.hotkeyTopmost.disabled = !config.topmost.enabled;

if(config.topmost.hotkeyMod && config.topmost.hotkeyVk){
	mainForm.hotkeyTopmost.sethotkey(config.topmost.hotkeyMod, config.topmost.hotkeyVk);
}
else {
	// 默认 Ctrl+Alt+T
	mainForm.hotkeyTopmost.sethotkey(2/*_MOD_CONTROL*/ | 1/*_MOD_ALT*/, 0x54/*_VK_T*/);
}

mainForm.chkTopmost.oncommand = function(id,event){
	if(owner.checked){
		var mod, vk = mainForm.hotkeyTopmost.gethotkey();
		if(!vk){
			// 默认 Ctrl+Alt+T
			mainForm.hotkeyTopmost.sethotkey(2/*_MOD_CONTROL*/ | 1/*_MOD_ALT*/, 0x54/*_VK_T*/);
			mod = 2/*_MOD_CONTROL*/ | 1/*_MOD_ALT*/;
			vk = 0x54/*_VK_T*/;
		}
		config.topmost.enabled = true;
		config.topmost.hotkeyMod = mod;
		config.topmost.hotkeyVk = vk;
		config.topmost.save();
		
		import app.topmost;
		app.topmost.registerHotkey(mainForm);
		mainForm.hotkeyTopmost.disabled = false;
	}
	else {
		import app.topmost;
		app.topmost.unregisterHotkey(mainForm);
		
		config.topmost.enabled = false;
		config.topmost.save();
		mainForm.hotkeyTopmost.disabled = true;
	}
}

mainForm.hotkeyTopmost.oncommand = function(id,event){
	if(!mainForm.chkTopmost.checked) return;
	
	var mod, vk = mainForm.hotkeyTopmost.gethotkey();
	if(!vk) return;
	
	import app.topmost;
	app.topmost.unregisterHotkey(mainForm);
	
	config.topmost.hotkeyMod = mod;
	config.topmost.hotkeyVk = vk;
	config.topmost.save();
	
	app.topmost.registerHotkey(mainForm);
}

 
if(..config.setting.imeBarDisabled){
	imeBar.imeWatch(false);  
}
else {
	mainForm.chkImeBarDisabled.checked = true; 
}

